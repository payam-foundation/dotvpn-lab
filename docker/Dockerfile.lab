# Lab runner for the packet-level suites (Linux netns, nftables, tc, NFQUEUE).
# Never pushed to a public registry. Run with:
#   docker run --rm --cap-add NET_ADMIN --cap-add SYS_ADMIN ...
# Test binaries are cross-built on the host (see `make lab-docker`), so no Go
# toolchain is needed here.
FROM ubuntu@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      nftables iptables iproute2 iperf3 tcpdump ca-certificates procps iputils-ping \
 && rm -rf /var/lib/apt/lists/*
